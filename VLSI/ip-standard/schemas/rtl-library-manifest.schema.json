
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KritvaOS/kritva-standard/main/VLSI/ip-standard/schemas/rtl-library-manifest.schema.json",
  "title": "KRITVA Approved RTL Library Manifest",
  "description": "Machine-readable manifest of approved RTL library modules. This manifest is the sole technology boundary for technology-dependent RTL in KRITVA IP. It does not identify or authorize unlisted technology-specific cells.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "status",
    "owner",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "deprecated",
        "retired"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "module_name",
        "source_path",
        "technology_independent",
        "status",
        "approval_reference",
        "owner",
        "supported_interfaces_ports",
        "verification_evidence_references",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "reset_synchronizer",
            "clock_gate",
            "clock_mux",
            "level_shifter",
            "memory_wrapper",
            "other"
          ]
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "technology_independent": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "deprecated",
            "retired"
          ]
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "supported_interfaces_ports": {
          "type": "object",
          "description": "Summary of supported interfaces, port names, directions, widths, parameters, and relevant usage constraints.",
          "additionalProperties": {
            "type": [
              "string",
              "array",
              "object"
            ]
          }
        },
        "verification_evidence_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "approval_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
